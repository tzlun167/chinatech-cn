# ── 資料庫 ──────────────────────────────────────────────
DATABASE_URL=postgres://chinatech:CHANGE_ME@127.0.0.1:5432/chinatech_cn

# ── Payload ────────────────────────────────────────────
# 產生方式：openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME

# ── 站台 ───────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3300

# ── 到訪監控（Umami 自架）─────────────────────────────
# 建好 Umami 站點後填入；留空則前台不注入追蹤腳本
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
